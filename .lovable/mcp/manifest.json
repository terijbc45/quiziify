{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://bwznlywilhbshlexjfdk.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "quiziify-mcp",
      "version": "0.1.0",
      "title": "Quiziify"
    },
    "tools": [
      {
        "name": "get_profile",
        "title": "Get my Quiziify profile",
        "description": "Returns the signed-in user's Quiziify profile (display name, class, country, bio, optional subjects).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_reminders",
        "title": "List my reminders",
        "description": "Lists the signed-in user's Quiziify reminders (title, body, fire time, fired state), most recent first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Max reminders to return (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_reminder",
        "title": "Create a reminder",
        "description": "Creates a new Quiziify reminder for the signed-in user. fire_at must be an ISO-8601 timestamp.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "body": {
              "type": "string",
              "maxLength": 600
            },
            "fire_at": {
              "type": "string",
              "description": "ISO-8601 timestamp for when the reminder should fire."
            }
          },
          "required": [
            "title",
            "fire_at"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_my_posts",
        "title": "List my posts",
        "description": "Lists the signed-in user's published quiz posts (question, topic, difficulty), most recent first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_quiz_attempts",
        "title": "List my recent quiz attempts",
        "description": "Lists the signed-in user's recent Quiziify quiz attempts with score and mode.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
